
# Drupal 11 - Composer project
# Document root: web/

# Composer dependencies
/vendor/
/composer.phar

# Drupal core
/web/core/

# Composer-managed contributed modules, themes and profiles
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/

# Drupal runtime and uploaded files
/web/sites/*/files/
/web/sites/*/private/
/web/sites/*/tmp/
/web/sites/*/php/
/web/sites/*/translations/

# Sensitive Drupal settings
/web/sites/*/settings.php
/web/sites/*/settings.local.php
/web/sites/*/services.yml
/web/sites/*/services.local.yml
/web/sites/*/development.services.yml

# Private keys and local configuration
/keys/
/config/*/local/

# Drush
/drush/contrib/
/drush/sites/

# Frontend dependencies and generated output
/node_modules/
/npm-debug.log*
/yarn-error.log*
/pnpm-debug.log*
/dist/
/build/

# Testing
/phpunit.xml
/.phpunit.result.cache
/test-output/

# IDE and operating system files
.idea/
.vscode/
*.swp
*.swo
*.sublime-*
.DS_Store
Thumbs.db

# Editor backups
*~
*.un~

# NFS temporary files
.nfs*

# Environment variables
.env
.env.*
!.env.example

# Database backups and archives
*.sql
*.sql.gz
*.tar.gz
*.zip

# Composer cache
.cache/

# Project-specific files that should remain tracked
!/composer.json
!/composer.lock
!/web/.htaccess
!/web/sites/*/settings.example.php

# Custom Drupal modules, themes and profiles
!/web/modules/custom/
!/web/themes/custom/
!/web/profiles/custom/

# Drupal configuration export
!/config/sync/

# Custom and legacy themes
# Keep web/themes/d8w3css in Git if required by your theme.

# Drupal recipes
# Keep project-owned recipes in Git.

# Manually managed frontend libraries
# Do not ignore /web/libraries/ globally unless
# all libraries are installed automatically by Composer.

# Git attributes
# Keep .gitattributes tracked for consistent line endings.

