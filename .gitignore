!/web/themes/custom/

# Custom Drupal profiles
!/web/profiles/custom/

# Drupal configuration export
!/config/sync/

# Project dependency definitions
!/composer.json
!/composer.lock

# Drupal web server configuration
!/web/.htaccess

# Example settings
!/web/sites/*/settings.example.php

# --------------------------------------------------
# Project-specific directories
# --------------------------------------------------

# Legacy D8W3CSS base theme required by tthz10:
#  web/themes/d8w3css/
# Keep tracked until its dependency is resolved.

# Drupal recipes:
# recipes/
# Keep project-owned recipes tracked.
/.gitattributes
